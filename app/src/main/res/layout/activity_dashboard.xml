<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <TextView android:id="@+id/tvSalam034" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold"
                android:textColor="#1C1C1E" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ringkasan keuanganmu" android:textColor="#6E6E73"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="28dp" android:layout_marginTop="24dp"
                android:background="@drawable/bg_glass">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Saldo Total" android:textColor="#6E6E73"/>
                <TextView android:id="@+id/tvSaldo034" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="36sp" android:textStyle="bold"
                    android:textColor="#1C1C1E" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvJumlah034" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="12sp"
                    android:textColor="#6E6E73" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:padding="18dp"
                    android:layout_marginEnd="7dp" android:background="@drawable/bg_glass">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pemasukan" android:textColor="#6E6E73" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvMasuk034" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp"
                        android:textColor="#34C759" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:padding="18dp"
                    android:layout_marginStart="7dp" android:background="@drawable/bg_glass">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pengeluaran" android:textColor="#6E6E73" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvKeluar034" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp"
                        android:textColor="#FF3B30" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnTambahCepat034"
                style="@style/Glass.Btn.Primary" android:layout_marginTop="28dp"
                android:text="+ Catat Transaksi Baru"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLihat034"
                style="@style/Glass.Btn.Secondary" android:layout_marginTop="12dp"
                android:text="Lihat Semua Transaksi"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav034" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_nav"
        android:theme="@style/Theme.MaterialComponents.Light"
        app:menu="@menu/menu_bottom" app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item" app:labelVisibilityMode="labeled" app:elevation="0dp"/>
</LinearLayout>