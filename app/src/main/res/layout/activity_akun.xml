<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Akun" android:textSize="28sp" android:textStyle="bold"
                android:textColor="#1C1C1E" android:layout_marginTop="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp" android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Masuk sebagai" android:textColor="#6E6E73" android:textSize="12sp"/>
                <TextView android:id="@+id/tvNamaAkun011" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#1C1C1E" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tvJumlahAkun011" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="#6E6E73" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp" android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Anggota Kelompok 5" android:textStyle="bold" android:textSize="16sp"
                    android:textColor="#1C1C1E"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:lineSpacingExtra="6dp" android:textColor="#3A3A3C"
                    android:text="Adiba Mauliya\n102042330021\n\nLaisyawhara Fhateha Syam\n102042300001\n\nArdelia Elvina\n102042330034\n\nAna Roehana\n102042330155\n\nJauza Najla\n102042300011"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLogout011"
                style="@style/Glass.Btn.Danger" android:layout_marginTop="24dp" android:text="Keluar"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavAkun011" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_nav"
        android:theme="@style/Theme.MaterialComponents.Light"
        app:menu="@menu/menu_bottom" app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item" app:labelVisibilityMode="labeled" app:elevation="0dp"/>
</LinearLayout>


