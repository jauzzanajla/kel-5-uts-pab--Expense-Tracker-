<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_glass">
            <TextView android:id="@+id/btnKembali001" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="‹ Kembali" android:textColor="#007AFF"
                android:textSize="16sp" android:padding="4dp" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Buat Akun" android:textSize="28sp" android:textStyle="bold"
                android:textColor="#1C1C1E"/>
            <EditText android:id="@+id/etUsername001" style="@style/Glass.Input"
                android:layout_marginTop="20dp" android:hint="Username (min. 3 karakter)" android:inputType="text"/>
            <EditText android:id="@+id/etPassword001" style="@style/Glass.Input"
                android:layout_marginTop="12dp" android:hint="Password (min. 6 karakter)" android:inputType="textPassword"/>
            <EditText android:id="@+id/etKonfirmasi001" style="@style/Glass.Input"
                android:layout_marginTop="12dp" android:hint="Ulangi password" android:inputType="textPassword"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDaftar001"
                style="@style/Glass.Btn.Primary" android:layout_marginTop="20dp" android:text="Daftar"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
